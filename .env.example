# E-Career Platform - Environment Configuration
# Copy this to backend/.env and fill in any missing values

# ============================================
# Django Core
# ============================================
SECRET_KEY=your-secret-key-generate-with-django
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,jobs.usamif.com
ADMIN_URL=admin/

# ============================================
# Database
# ============================================
DATABASE_URL=postgresql://postgres:your-password@localhost:5432/ecareer_dev

# ============================================
# Redis
# ============================================
REDIS_URL=redis://localhost:6379/0

# ============================================
# Celery
# ============================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ============================================
# AWS Bedrock (Multi-Model Strategy)
# ============================================
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=<aws-secret-key-redacted>
AWS_DEFAULT_REGION=us-east-1

# Model Configuration (Smart Cost-Effective Strategy)
BEDROCK_MODEL_PRIMARY=meta.llama4-scout-17b-instruct-v1:0
BEDROCK_MODEL_SECONDARY=google.gemma-4-e2b

# Task-Specific Models
RASHID_CHAT_MODEL=meta.llama4-scout-17b-instruct-v1:0
CV_PARSING_MODEL=google.gemma-4-e2b
JOB_MATCHING_MODEL=meta.llama4-scout-17b-instruct-v1:0
COVER_LETTER_MODEL=meta.llama4-scout-17b-instruct-v1:0
EMAIL_GENERATION_MODEL=google.gemma-4-e2b
QUICK_TASKS_MODEL=google.gemma-4-e2b

# ============================================
# Encryption (Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# ============================================
FIELD_ENCRYPTION_KEY=your-generated-fernet-key-here

# ============================================
# Google OAuth (for email integration)
# ============================================
GOOGLE_CLIENT_ID=<google-client-id-redacted>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-<google-secret-redacted>
GOOGLE_PROJECT_ID=<google-project-redacted>

# ============================================
# Email Accounts (Google Workspace)
# ============================================
EMAIL_TRACKING_DOMAIN=https://jobs.usamif.com

# Primary email account
EMAIL_ACCOUNT_1_EMAIL=career@usamif.com
EMAIL_ACCOUNT_1_PASSWORD=app-password-here
EMAIL_ACCOUNT_1_DISPLAY_NAME=USAM Career

# Add more accounts for rotation
# EMAIL_ACCOUNT_2_EMAIL=noreply@usamif.com
# EMAIL_ACCOUNT_2_PASSWORD=app-password-here
# EMAIL_ACCOUNT_2_DISPLAY_NAME=USAM Career

# ============================================
# Course Platform Integration
# ============================================
EDU_PLATFORM_URL=https://edu.usamif.com
EDU_PLATFORM_API_KEY=optional-if-api-available

# ============================================
# Site Configuration
# ============================================
SITE_URL=http://localhost:8000
SITE_NAME=USAM Career Platform

# ============================================
# Optional Services
# ============================================
# Company logos
CLEARBIT_API_KEY=optional-clearbit-key

# Monitoring
SENTRY_DSN=optional-sentry-dsn
SENTRY_ENVIRONMENT=development

# ============================================
# Security (Production Only)
# ============================================
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# ============================================
# File Storage
# ============================================
MEDIA_ROOT=media
STATIC_ROOT=staticfiles
