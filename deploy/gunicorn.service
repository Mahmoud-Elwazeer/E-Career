[Unit]
Description=Gunicorn daemon for E-Career Platform
After=network.target

[Service]
Type=notify
User=www-usam
Group=www-data
WorkingDirectory=/var/www/usam/backend
Environment="PATH=/var/www/usam/venv/bin"
EnvironmentFile=/var/www/usam/backend/.env
ExecStart=/var/www/usam/venv/bin/gunicorn \
    --workers 4 \
    --bind 127.0.0.1:8000 \
    --timeout 120 \
    --access-logfile /var/www/usam/logs/gunicorn-access.log \
    --error-logfile /var/www/usam/logs/gunicorn-error.log \
    --log-level info \
    config.wsgi:application
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=5
PrivateTmp=true
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
