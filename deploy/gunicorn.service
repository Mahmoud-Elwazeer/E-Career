[Unit]
Description=USAM Career Compass — Gunicorn WSGI Server
Documentation=https://docs.gunicorn.org
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=notify
User=www-usam
Group=www-data
RuntimeDirectory=gunicorn-usam
WorkingDirectory=/var/www/usam/backend

# Load .env variables
EnvironmentFile=/var/www/usam/backend/.env
Environment="DJANGO_SETTINGS_MODULE=config.settings.production"

# Gunicorn command — 3 workers, bind to localhost only
ExecStart=/var/www/usam/venv/bin/gunicorn \
    config.wsgi:application \
    --workers 3 \
    --worker-class sync \
    --bind 127.0.0.1:8000 \
    --timeout 60 \
    --keep-alive 5 \
    --max-requests 1000 \
    --max-requests-jitter 100 \
    --log-level info \
    --access-logfile /var/www/usam/logs/gunicorn_access.log \
    --error-logfile /var/www/usam/logs/gunicorn_error.log \
    --capture-output

ExecReload=/bin/kill -s HUP $MAINPID

# Auto-restart on crash
Restart=on-failure
RestartSec=5s
KillMode=mixed
TimeoutStopSec=30

# Security hardening
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/www/usam

[Install]
WantedBy=multi-user.target
