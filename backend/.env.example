# ─────────────────────────────────────────────
# USAM Career Compass — Backend Environment
# Copy this file to .env and fill in all values
# ─────────────────────────────────────────────

# ── Django ──────────────────────────────────
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here-change-me

DEBUG=False

# Comma-separated list of allowed hostnames
ALLOWED_HOSTS=localhost,127.0.0.1,jobs.usamif.com

# Path to admin panel — keep this secret in production
ADMIN_URL=secret-admin-path/

# ── Database ─────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgres://usam_user:strong_password@localhost:5432/usam_db

# ── Redis ────────────────────────────────────
# Redis connection for caching and Celery
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6379/1

# ── Frontend ─────────────────────────────────
FRONTEND_URL=https://jobs.usamif.com

# ── CORS ─────────────────────────────────────
# Comma-separated allowed origins
# Production: https://jobs.usamif.com
# Development: http://localhost:5173,http://localhost:3000
CORS_ALLOWED_ORIGINS=https://jobs.usamif.com,http://localhost:5173,http://localhost:3000

# ── JWT ──────────────────────────────────────
# Token lifetimes
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7

# ── Auth — Google OAuth ──────────────────────
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email (SMTP) ──────────────────────────────
# For Gmail: use an App Password (not your main password)
# Create at: https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password-here
DEFAULT_FROM_EMAIL=noreply@jobs.usamif.com

# ── File Uploads ─────────────────────────────
# Absolute path to media directory on the server
MEDIA_ROOT=/var/www/usam/media
MAX_UPLOAD_SIZE_MB=10

# ── Typesense Search ────────────────────────
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=your-typesense-api-key-here
SEARCH_TRUST_SCORE_THRESHOLD=0.4

# ── Cohere API (for embeddings) ───────────────
COHERE_API_KEY=your-cohere-api-key-here

# ── AWS Bedrock ─
# Get credentials from: https://console.aws.amazon.com/iam/home
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_DEFAULT_REGION=eu-north-1

# ── Encryption key for sensitive fields (Rashid conversations) ─
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=your-fernet-key-here-generate-one-with-the-command-above

# ── Sentry Error Tracking ─────────────────────
# Get DSN from: https://sentry.io
SENTRY_DSN=

# ── Domain ────────────────────────────────────
SITE_URL=https://jobs.usamif.com