# ─────────────────────────────────────────────
# USAM Career Compass — Backend Environment
# Copy this file to .env and fill in all values
# ─────────────────────────────────────────────

# ── Django ──────────────────────────────────
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here-change-me

DEBUG=False

# Comma-separated list of allowed hostnames
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Path to admin panel — keep this secret in production
ADMIN_URL=secret-admin-path/

# ── Database ─────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgres://usam_user:strong_password@localhost:5432/usam_db

# ── Frontend ─────────────────────────────────
FRONTEND_URL=https://yourdomain.com

# CORS — comma-separated allowed origins
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── Auth — Google OAuth ──────────────────────
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email (SMTP) ──────────────────────────────
# For Gmail: use an App Password (not your main password)
# Create at: https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password-here
DEFAULT_FROM_EMAIL=noreply@usam.jobs

# ── File Uploads ─────────────────────────────
# Absolute path to media directory on the server
MEDIA_ROOT=/var/www/usam/media
MAX_UPLOAD_SIZE_MB=10
