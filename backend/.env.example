# ─────────────────────────────────────────────────────────────────────────────
# USAM Career Compass — Backend Environment Variables
# Copy to .env and fill in values marked REQUIRED.
# Variables with defaults shown in comments are optional overrides.
# ─────────────────────────────────────────────────────────────────────────────

# ── Django Core ──────────────────────────────────────────────────────────────
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-in-production-please
# default: "change-me-in-production-please"

ALLOWED_HOSTS=localhost,127.0.0.1
# default: "localhost,127.0.0.1" (comma-separated)

ADMIN_URL=admin/
# default: "admin/"

FRONTEND_URL=http://localhost:5173
# default: "http://localhost:5173"

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# default: "http://localhost:5173,http://localhost:3000" (comma-separated)

# ── Database ─────────────────────────────────────────────────────────────────
# REQUIRED in production (no default). In dev, falls back to SQLite if empty.
DATABASE_URL=postgres://usam_user:strong_password@localhost:5432/usam_db

# ── Redis / Channels ────────────────────────────────────────────────────────
REDIS_HOST=redis://localhost:6379/0
# default: "redis://localhost:6379/0" (used by Django Channels)

REDIS_CACHE_URL=redis://localhost:6379/1
# default: "redis://localhost:6379/1" (used by django-redis cache backend)

# ── Celery ───────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
# default: "redis://localhost:6379/0"

CELERY_RESULT_BACKEND=redis://localhost:6379/0
# default: "redis://localhost:6379/0"

# ── AWS / Bedrock ────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
# default: "" (REQUIRED for AI features)

AWS_SECRET_ACCESS_KEY=
# default: "" (REQUIRED for AI features)

AWS_DEFAULT_REGION=us-east-1
# default: "us-east-1"

BEDROCK_MODEL_ID=us.anthropic.claude-3-5-haiku-20241022-v1:0
# default: "us.anthropic.claude-3-5-haiku-20241022-v1:0"

# ── AI / Intelligence ────────────────────────────────────────────────────────
AI_USER_DAILY_TOKEN_LIMIT=50000
# default: 50000

CHANGE_DETECTION_URL=http://localhost:5000
# default: "http://localhost:5000" (career page monitoring)

CHANGE_DETECTION_API_KEY=
# default: ""

# ── AWS Billing Alerts ───────────────────────────────────────────────────────
AWS_BILLING_ALERT_THRESHOLD=100
# default: 100 (USD)

AWS_BILLING_ALERT_EMAIL=
# default: ""

AWS_BILLING_MONITOR_ENABLED=False
# default: False

# ── Email (SMTP — production only) ──────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
# default: "smtp.gmail.com"

EMAIL_PORT=587
# default: 587

EMAIL_HOST_USER=
# default: "" (REQUIRED for production email)

EMAIL_HOST_PASSWORD=
# default: "" (REQUIRED for production email)

DEFAULT_FROM_EMAIL=noreply@usam.jobs
# default: "noreply@usam.jobs"

# ── Google OAuth ─────────────────────────────────────────────────────────────
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
# default: ""

GOOGLE_CLIENT_SECRET=
# default: ""

# ── File Storage ─────────────────────────────────────────────────────────────
MEDIA_ROOT=
# default: "<BASE_DIR>/media"

MAX_UPLOAD_SIZE_MB=10
# default: 10

# ── Search / Typesense ───────────────────────────────────────────────────────
TYPESENSE_HOST=localhost
# default: "localhost"

TYPESENSE_PORT=8108
# default: "8108"

TYPESENSE_PROTOCOL=http
# default: "http"

TYPESENSE_API_KEY=ecareer_typesense_dev_key
# default: "ecareer_typesense_dev_key"

SEARCH_TRUST_SCORE_THRESHOLD=0.4
# default: 0.4

# ── ClamAV Malware Scanning ─────────────────────────────────────────────────
CLAMAV_HOST=
# default: None (disabled when not set)

CLAMAV_PORT=3310
# default: 3310

CLAMAV_SOCKET=/var/run/clamav/clamd.ctl
# default: "/var/run/clamav/clamd.ctl"

CLAMAV_FAIL_CLOSED=True
# default: True (reject uploads if scan unavailable)

# ── Encryption ───────────────────────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
# default: "" (REQUIRED for encrypted fields to work)

# ── Sentry Error Tracking ───────────────────────────────────────────────────
SENTRY_DSN=
# default: "" (disabled when empty)
